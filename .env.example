# This file documents service-manager environment values; homecmd does not load dotenv files.
HOMECMD_HOST=127.0.0.1
HOMECMD_PORT=8000
HOMECMD_AUDIT_LOG=C:/Users/username/.homecmd/audit.jsonl
HOMECMD_VAULT_ROOT=C:/path/to/Obsidian-vault
HOMECMD_POLICY=configs/policy.local.toml

LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=
WORKER_MAX_INPUT_CHARS=24000
WORKER_MAX_OUTPUT_CHARS=6000
WORKER_TIMEOUT_SECONDS=120

# Required only for non-loopback deployment behind TLS termination.
HOMECMD_TOKEN=
HOMECMD_TLS_TERMINATED=false
